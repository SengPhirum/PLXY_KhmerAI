# =============================================================================
# Khmer Customer-Support LLM - environment template
# -----------------------------------------------------------------------------
# Copy to `.env` and fill in real values.  NEVER commit `.env`.
#   cp .env.example .env
# Every variable below is read by `server/config.py` (prefix KHMERAI_) or by the
# shell scripts under `scripts/`, `ollama/` and `deployment/`.
# =============================================================================

# --- Application ------------------------------------------------------------
KHMERAI_ENV=development                  # development | staging | production
KHMERAI_APP_NAME=khmer-support-llm
KHMERAI_HOST=127.0.0.1
KHMERAI_PORT=8000
KHMERAI_WORKERS=1                        # keep 1: Ollama is the concurrency bottleneck
KHMERAI_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
KHMERAI_LOG_FORMAT=json                  # json | console
KHMERAI_CONFIG_FILE=configs/production/api.yaml

# --- Security ---------------------------------------------------------------
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
KHMERAI_ADMIN_API_KEY=CHANGE_ME_ADMIN_KEY
# Comma-separated client keys.  Leave empty to disable client authentication
# (only acceptable on a trusted LAN behind a reverse proxy).
KHMERAI_CLIENT_API_KEYS=
KHMERAI_REQUIRE_CLIENT_AUTH=false
KHMERAI_CORS_ORIGINS=http://localhost:3000
KHMERAI_MAX_REQUEST_BYTES=65536
KHMERAI_MAX_MESSAGE_CHARS=4000

# --- Rate limiting ----------------------------------------------------------
KHMERAI_RATE_LIMIT_ENABLED=true
KHMERAI_RATE_LIMIT_REQUESTS=30           # requests per window per client
KHMERAI_RATE_LIMIT_WINDOW_SECONDS=60
KHMERAI_RATE_LIMIT_BURST=10

# --- Ollama -----------------------------------------------------------------
OLLAMA_HOST=127.0.0.1:11434
KHMERAI_OLLAMA_BASE_URL=http://127.0.0.1:11434
KHMERAI_OLLAMA_MODEL=khmer-support-9b
KHMERAI_OLLAMA_FALLBACK_MODEL=khmer-support-4b
KHMERAI_OLLAMA_CONNECT_TIMEOUT_S=5
KHMERAI_OLLAMA_READ_TIMEOUT_S=120
KHMERAI_OLLAMA_TOTAL_TIMEOUT_S=180

# Server-side Ollama runtime (exported by ollama/start_server.sh and launchd).
# Values below are STARTING POINTS - replace with the winners from
# `ollama/benchmark.sh` (see reports/final_load_test.md).
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_NUM_PARALLEL=4
OLLAMA_MAX_QUEUE=64
OLLAMA_KEEP_ALIVE=-1
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_MAX_LOADED_MODELS=1

# --- Generation defaults (benchmark before changing) ------------------------
KHMERAI_TEMPERATURE=0.3
KHMERAI_TOP_P=0.9
KHMERAI_TOP_K=40
KHMERAI_REPEAT_PENALTY=1.05
KHMERAI_MAX_OUTPUT_TOKENS=768
KHMERAI_NUM_CTX=8192

# --- Concurrency / queueing -------------------------------------------------
KHMERAI_MAX_ACTIVE_GENERATIONS=4         # must be <= OLLAMA_NUM_PARALLEL
KHMERAI_MAX_QUEUE_DEPTH=64
KHMERAI_QUEUE_TIMEOUT_S=20

# --- RAG --------------------------------------------------------------------
KHMERAI_RAG_ENABLED=true
KHMERAI_RAG_CONFIG=configs/rag/retrieval.yaml
KHMERAI_INDEX_ROOT=data/index
KHMERAI_INDEX_ACTIVE_POINTER=data/index/ACTIVE
KHMERAI_VECTOR_BACKEND=local             # local | qdrant
KHMERAI_QDRANT_URL=http://127.0.0.1:6333
KHMERAI_QDRANT_API_KEY=
KHMERAI_QDRANT_COLLECTION=khmer_company_kb
KHMERAI_EMBEDDING_BACKEND=ollama         # ollama | sentence_transformers | hashing
KHMERAI_EMBEDDING_MODEL=qwen3-embedding:0.6b
KHMERAI_EMBEDDING_DIM=1024
KHMERAI_RETRIEVAL_TIMEOUT_S=5

# --- Conversation memory ----------------------------------------------------
KHMERAI_CONVERSATION_TTL_SECONDS=3600
KHMERAI_CONVERSATION_MAX_TURNS=12
KHMERAI_CONVERSATION_STORE=memory        # memory | none
KHMERAI_PERSIST_CONVERSATIONS=false
KHMERAI_ANONYMISE_LOGS=true

# --- Company data -----------------------------------------------------------
KHMERAI_COMPANY_DOCS_DIR=data/raw/company
KHMERAI_COMPANY_ALLOWED_EXTENSIONS=.pdf,.docx,.html,.htm,.txt,.md,.csv,.xlsx
KHMERAI_COMPANY_MAX_FILE_MB=50

# --- Training / datasets (Colab or Linux GPU box) ---------------------------
HF_TOKEN=
HF_HOME=~/.cache/huggingface
KHMERAI_DATA_ROOT=data
KHMERAI_SEED=20260814
WANDB_API_KEY=
WANDB_PROJECT=khmer-support-llm
WANDB_MODE=offline                       # offline unless explicitly approved

# --- Monitoring -------------------------------------------------------------
KHMERAI_METRICS_ENABLED=true
KHMERAI_METRICS_PATH=/metrics
PROMETHEUS_PORT=9090

# --- Backup -----------------------------------------------------------------
KHMERAI_BACKUP_DIR=/usr/local/var/khmerai/backups
KHMERAI_BACKUP_RETENTION_DAYS=30
# Age/GPG recipient used by deployment/backup/backup.sh to encrypt archives.
KHMERAI_BACKUP_GPG_RECIPIENT=
